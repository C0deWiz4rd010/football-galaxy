{
  "name": "football-galaxy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n vite,proxy -c cyan,magenta \"npm:dev\" \"npm:proxy:dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "proxy:dev": "node --env-file=.env ./proxy/football-data-proxy.mjs",
    "snapshot:leagues": "node scripts/snapshot-leagues.mjs",
    "build:mock": "node scripts/build-mock-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
