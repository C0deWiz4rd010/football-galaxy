# ---------------------------------------------------------------------------
# Football Galaxy environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (kept out of git) and fill in the values you need.
# Only variables prefixed with VITE_ reach the browser bundle; the API key has
# no prefix and stays on the proxy.
# ---------------------------------------------------------------------------

# URL of the live-data proxy the app calls.
# - Local development: leave empty → http://localhost:8787/api/live
# - Hostinger: set automatically by `npm run build:hostinger` (/api/live.php)
# - GitHub Pages: a repository variable pointing at a deployed proxy
VITE_LIVE_DATA_PROXY_URL=

# Public address of the deployed app (origin + base path, no trailing slash),
# e.g. https://football-galaxy.example. Enables sitemap.xml and absolute
# link-preview URLs in the build; leave empty for local development.
VITE_SITE_URL=

# Dev escape hatch: call upstream APIs directly (no proxy). football-data.org
# will not work this way (key + CORS).
VITE_DISABLE_DEV_LIVE_PROXY=false

# ---------------------------------------------------------------------------
# Proxy only — never prefix with VITE_
# ---------------------------------------------------------------------------

# football-data.org free-tier key (https://www.football-data.org/client/register).
# Used for the World Cup 2026 archive, team stadium/coach data and as the
# fallback league source. All visitors share its 10 requests/minute, which the
# proxy enforces (proxy/SPEC.md).
FOOTBALL_DATA_API_KEY=

# Origins allowed to call the proxy from another origin (comma-separated).
# The dev proxy defaults to the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev proxy port.
PROXY_PORT=8787
