# ---------------------------------------------------------------------------
# Football Galaxy environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (kept out of git) and fill in the values you need.
# Only the variables prefixed with VITE_ are exposed to the browser bundle —
# server-only secrets (API keys) live without that prefix and stay on the
# proxy.
# ---------------------------------------------------------------------------

# Public URL of the running proxy. Required for live mode in the browser.
# Local development:  http://localhost:8787/api/live
# Production:         https://<your-worker-or-edge-host>/api/live
VITE_LIVE_DATA_PROXY_URL=

# ---------------------------------------------------------------------------
# Proxy-only (NEVER expose to the browser — no VITE_ prefix)
# ---------------------------------------------------------------------------

# football-data.org free-tier API key. Sign up at
#   https://www.football-data.org/client/register
# Free tier allows 10 requests/minute and covers the top-5 European leagues
# (standings, fixtures, scorers, official crests). The proxy attaches this
# token automatically when forwarding requests to api.football-data.org.
FOOTBALL_DATA_API_KEY=

# TheSportsDB v1 public key. The literal value `123` is the documented free
# tier and is fine to ship. Only set this if you have upgraded to a paid key.
SPORTSDB_API_KEY=123
