# ---------------------------------------------------------------------------
# Football Galaxy environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` (kept out of git) and fill in the values you need.
# Only the variables prefixed with VITE_ are exposed to the browser bundle —
# server-only secrets (API keys) live without that prefix and stay on the
# proxy.
# ---------------------------------------------------------------------------

# Public URL of the running proxy.
# Local development defaults to http://localhost:8787/api/live when this is
# empty. Production builds should set the deployed proxy URL explicitly.
# Local development:  http://localhost:8787/api/live
# Production:         https://<your-worker-or-edge-host>/api/live
VITE_LIVE_DATA_PROXY_URL=

# Optional dev escape hatch. Set to true when you intentionally want direct
# upstream URLs during local tests.
VITE_DISABLE_DEV_LIVE_PROXY=false

# ---------------------------------------------------------------------------
# Proxy-only (NEVER expose to the browser — no VITE_ prefix)
# ---------------------------------------------------------------------------

# football-data.org free-tier API key. Sign up at
#   https://www.football-data.org/client/register
# Free tier allows 10 requests/minute and covers the top-5 European leagues
# (standings, fixtures, scorers, official crests). The proxy attaches this
# token automatically when forwarding requests to api.football-data.org.
FOOTBALL_DATA_API_KEY=

# API-Football / API-Sports key. OPTIONAL. When set, it powers live World Cup
# 2026 fixtures, line-ups and in-match statistics. When absent (or offline), the
# World Cup area automatically falls back to a free, structural offline snapshot
# so it is never blank. Never prefix this with VITE_; the browser must not
# receive it.
API_FOOTBALL_KEY=

# TheSportsDB v1 public key. The literal value `123` is the documented free
# tier and is fine to ship. Only set this if you have upgraded to a paid key.
SPORTSDB_API_KEY=123

# Proxy response-cache TTL in milliseconds (default 60000). The proxy caches
# successful upstream responses and serves the cached copy when an upstream
# returns 429 (rate limited) or is unreachable, so the free football-data.org
# tier (10 req/min) stays responsive. Set to 0 to effectively disable reuse.
PROXY_CACHE_TTL_MS=60000
